# Copy to .env and replace REPLACE_ME. .env is gitignored.
# The app refuses to start if the secret is shorter than 32 characters,
# so forgetting to replace this placeholder fails loudly instead of silently.
ACCESSDESK_JWT_SECRET=REPLACE_ME
ACCESSDESK_JWT_ISSUER=accessdesk
ACCESSDESK_JWT_AUDIENCE=accessdesk-api
ACCESSDESK_ACCESS_TOKEN_MINUTES=15
ACCESSDESK_DATABASE_PATH=accessdesk.db
